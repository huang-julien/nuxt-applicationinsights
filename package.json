{
  "name": "nuxt-applicationinsights",
  "version": "1.0.2",
  "description": "Application insights integration for Nuxt",
  "repository": "huang-julien/nuxt-applicationinsights",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "nuxt",
    "applicationinsights",
    "azure",
    "microsoft",
    "nuxt-module"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime/*": {
      "types": "./dist/runtime/*.d.mts",
      "import": "./dist/runtime/*.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build --stub && nuxi prepare && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@microsoft/applicationinsights-core-js": "catalog:",
    "@microsoft/applicationinsights-web": "catalog:",
    "@nuxt/eslint": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "applicationinsights": "catalog:",
    "defu": "catalog:",
    "mlly": "catalog:",
    "nitro-applicationinsights": "catalog:",
    "nitro-opentelemetry": "catalog:"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "catalog:",
    "@nuxt/kit": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@types/node": "catalog:",
    "changelogen": "catalog:",
    "eslint": "catalog:",
    "nitropack": "catalog:",
    "nuxt": "catalog:",
    "nuxt-applicationinsights": "link:./",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "packageManager": "pnpm@12.3.4"
}
